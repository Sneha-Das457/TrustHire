// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DEFAULT_USER
  CANDIDATE
}

enum CompanyRole {
  EMPLOYEE
  RECRUITER
  COMPANY_ADMIN
}

enum WorkMode {
  REMOTE
  ON_SITE
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEWING
  OFFER
  REJECTED
  HIRED
  WITHDRAWN
}

enum ApplicationSource {
  DIRECT
  REFERRAL
}

enum EducationLevel {
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(DEFAULT_USER)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  companyMembers CompanyMember[]
  candidate      Candidate?

  @@map("user")
}

model Candidate {
  id     String @id @default(uuid())
  userId String @unique

  resumeUrl    String
  headline     String
  location     String
  resumeName   String?
  bio          String?
  phone        String?
  portfolioUrl String?
  githubUrl    String?
  linkedinUrl  String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences  CandidateExperience[]
  educations   CandidateEducation[]
  skills       CandidateSkill[]
  applications Application[]
  savedJobs    SavedJob[]

  @@map("candidate")
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  jobId       String
  source      ApplicationSource @default(DIRECT)
  status      ApplicationStatus @default(SUBMITTED)
  coverLetter String?
  resumeUrl   String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  referral  Referral?

  @@unique([candidateId, jobId])
  @@index([jobId, status])
}

model Referral {
  id              String   @id @default(uuid())
  companyMemberId String
  applicationId   String   @unique
  note            String?
  referredAt      DateTime @default(now())

  companyMember CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([companyMemberId, referredAt])
}

model Company {
  id          String          @id
  name        String
  description String?
  website     String?
  location    String?
  industry    String?
  jobs        Job[]
  members     CompanyMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CompanyMember {
  id                  String      @id @default(uuid())
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  companyId           String
  role                CompanyRole
  jobTitle            String?
  department          String?
  joinedAt            DateTime    @default(now())
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referrals           Referral[]
  annualReferralLimit Int         @default(5)

  @@unique([userId, companyId])
}

model Job {
  id              String        @id
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  location        String
  workMode        WorkMode
  experience      Int?
  status          JobStatus     @default(DRAFT)
  employeeType    EmployeeType?
  allowsReferrals Boolean       @default(true)
  baseSalary      Int?
  applications    Application[]
  skills          JobSkill[]
  savedBy         SavedJob[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CandidateExperience {
  id          String    @id @default(uuid())
  candidateId String
  company     String
  position    String
  startDate   DateTime
  description String?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateEducation {
  id              String         @id @default(uuid())
  candidateId     String
  institution     String
  educationLevel  EducationLevel @default(OTHER)
  degree          String
  field           String?
  grade           String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean        @default(false)
  certificateUrl      String?
  certificateName     String?
  certificatePublicId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  id          String  @id @default(uuid())
  candidateId String
  skillId     String
  level       String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([skillId])
}

model JobSkill {
  id       String  @id @default(uuid())
  jobId    String
  skillId  String
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model SavedJob {
  id          String   @id @default(uuid())
  candidateId String
  jobId       String
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
