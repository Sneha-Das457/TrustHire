// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  EMPLOYEE
  RECRUITER
  COMPANY_ADMIN
}

enum CompanyRole {
  EMPLOYEE
  RECRUITER
  COMPANY_ADMIN
}

enum WorkMode {
  REMOTE
  ON_SITE
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEWING
  REJECTED
  HIRED
  WITHDRAWN
}

enum ApplicationSource {
  DIRECT
  REFERRAL
}

enum ReferralStatus {
  REFERRED
  REJECTED
  HIRED
}

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role UserRole @default(CANDIDATE)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  companyMembers CompanyMember[]
  candidate Candidate?

  @@map("user")
}



model Candidate {
  id     String @id
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?
  phone        String?
  portfolioUrl String?
  location     String?
  githubUrl    String?
  linkedinUrl  String?
  resumeUrl    String?
  experiences  Int?
  applications Application[]

  @@map("candidate")
}

model Application {
  id         String   @id @default(uuid())
  candidateId String
  jobId       String
  jobSource   ApplicationSource @default(DIRECT)
  status      ApplicationStatus @default(SUBMITTED)
  resumeUrl   String?
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  job         Job       @relation(fields: [jobId], references: [id])
  referrals   Referral?
  appliedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

 @@unique([candidateId, jobId])

}

model Referral {
  id           String   @id @default(uuid())
  companyMemberId String
  applicationId String  @unique
  referredAt DateTime @default(now())
  companyMember CompanyMember @relation(fields: [companyMemberId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  
}

model Company {
  id          String          @id
  name        String
  description String?
  website     String?
  location    String?
  industry    String?
  jobs        Job[]
  members     CompanyMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CompanyMember {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  companyId String
  role      CompanyRole
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referrals Referral[]
  annualReferralLimit Int @default(5)

  @@unique([userId, companyId])
}

model Job {
  id              String        @id
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  location        String
  workMode        WorkMode
  experience      Int?
  status          JobStatus     @default(DRAFT)
  employeeType    EmployeeType?
  allowsReferrals Boolean       @default(true)
  baseSalary      Int?
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
